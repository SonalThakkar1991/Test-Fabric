	measure 'Previous month Cst_Key' =
			
			
			VAR SelectedMonth = SELECTEDVALUE(Silver_Membership_V1[Join Date Month])  -- 2
			VAR SelectedYear = 2025  -- fixed year as per your logic
			
			
			VAR PrevMonth =
			    IF(SelectedMonth = 1, 12, SelectedMonth - 1) --1
			
			VAR PrevYear =
			    IF(SelectedMonth = 1, SelectedYear - 1, SelectedYear) --2025
			
			
			
			var result = CALCULATE(
			        DISTINCTCOUNT(Silver_Membership_V1[cst_cst_key]),
			        FILTER(
			            Silver_Membership_V1,
			            MONTH(Silver_Membership_V1[mbr_join_date]) = 1 &&
			            YEAR(Silver_Membership_V1[mbr_join_date]) = 2025
			        )
			    )
			
			    RETURN result
