	measure 'Total Expired Membership' = ```
			
			VAR SelectedMonth = 
			    SELECTEDVALUE(Membership_dashboard_data[Join Date Month], MONTH(TODAY()))
			VAR SelectedYear = 
			    SELECTEDVALUE(Membership_dashboard_data[Join Date year], YEAR(TODAY()))
			
			-- Define Key Date Variables
			VAR InvoiceStartDate = DATE(SelectedYear, SelectedMonth, 7)
			VAR InvoiceEndDate = DATE(SelectedYear, SelectedMonth + 1, 6)
			VAR JoinCutoffDate = DATE(SelectedYear, SelectedMonth + 1, 6)
			VAR InvoiceCutoffDate = DATE(SelectedYear, SelectedMonth + 1, 6)
			VAR ExpireCutoffDate = DATE(SelectedYear, SelectedMonth, 31)
			VAR MXITermStartCutoff = DATE(SelectedYear, SelectedMonth + 1, 6)
			VAR MXIPreviousTermEndCutoff = DATE(SelectedYear, SelectedMonth, 31)
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Membership_dashboard_data'[cst_cst_key]),
			    
			    -- First Condition Block (Members before renewal)
			    
			        'Membership_dashboard_data'[cst_cst_member_flag] = 0 &&
			        'Membership_dashboard_data'[mbr_expire_date] = ExpireCutoffDate &&
			        'Membership_dashboard_data'[mbr_terminate_date] >= ExpireCutoffDate &&
			        'Membership_dashboard_data'[mxi_delete_flag] = 0 &&
			        ISBLANK('Membership_dashboard_data'[ret_key]),
			        'Membership_dashboard_data'[mbr_join_date] < JoinCutoffDate &&
			        'Membership_dashboard_data'[mbr_invoice_date] > InvoiceCutoffDate &&
			        'Membership_dashboard_data'[cst_cst_member_flag] = 1 &&
			        'Membership_dashboard_data'[mbr_expire_date] > ExpireCutoffDate &&
			        'Membership_dashboard_data'[mxi_term_start_date] > MXITermStartCutoff &&
			        'Membership_dashboard_data'[mxi_previous_term_end_date] = MXIPreviousTermEndCutoff &&
			        --NOT ISBLANK('Silver_Membership_V1'[mbr_rejoin_date]) &&
			        ISBLANK('Membership_dashboard_data'[ret_key])
			    )
			
			```
		formatString: 0
		lineageTag: 0a307bcb-edf0-47da-a3bc-770751ca6cdf

	measure 'MoM Change (%)' = ```
			
			VAR SelectedMonth = SELECTEDVALUE(Membership_dashboard_data[ReportMonth])
			VAR SelectedYear = SELECTEDVALUE(Membership_dashboard_data[ReportYear])
			
			-- Previous Month & Year Logic
			VAR PrevMonth = IF(SelectedMonth = 1, 12, SelectedMonth - 1)
			VAR PrevYear = IF(SelectedMonth = 1, SelectedYear - 1, SelectedYear)
			
			-- Current Month Customer Count
			VAR CurrentMonthCustomer =
			    CALCULATE(
			        DISTINCTCOUNT(Membership_dashboard_data[cst_cst_key]),  -- Replace with your actual customer key column
			        Membership_dashboard_data[ReportMonth] = SelectedMonth &&
			        Membership_dashboard_data[ReportYear] = SelectedYear
			    )
			
			-- Previous Month Customer Count
			VAR PreviousMonthCustomer =
			    CALCULATE(
			        DISTINCTCOUNT(Membership_dashboard_data[cst_cst_key]),  -- Replace with your actual customer key column
			        Membership_dashboard_data[ReportMonth] = PrevMonth &&
			        Membership_dashboard_data[ReportYear] = PrevYear
			    )
			
			-- Final MoM %
			RETURN
			    DIVIDE(CurrentMonthCustomer - PreviousMonthCustomer, PreviousMonthCustomer)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 427fd4c1-b050-40ea-9629-c1b1f5a1e98e

	measure 'YoY Change (%)' = ```
			
			VAR SelectedMonth = SELECTEDVALUE(Membership_dashboard_data[ReportMonth])
			VAR SelectedYear = SELECTEDVALUE(Membership_dashboard_data[ReportYear])
			
			-- Current Year Customer Count
			VAR CurrentYearCustomer =
			    CALCULATE(
			        DISTINCTCOUNT(Membership_dashboard_data[cst_cst_key]),  -- Replace with your actual customer key
			        Membership_dashboard_data[ReportMonth] = SelectedMonth &&
			        Membership_dashboard_data[ReportYear] = SelectedYear
			    )
			
			-- Previous Year Customer Count (same month)
			VAR PreviousYearCustomer =
			    CALCULATE(
			        DISTINCTCOUNT(Membership_dashboard_data[cst_cst_key]),  -- Replace with your actual customer key
			        Membership_dashboard_data[ReportMonth] = SelectedMonth &&
			        Membership_dashboard_data[ReportYear] = SelectedYear - 1
			    )
			
			-- Final YoY %
			RETURN
			    DIVIDE(CurrentYearCustomer - PreviousYearCustomer, PreviousYearCustomer)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d4f278d4-d6d2-4fad-b8c1-58acdedb2fba

