	measure 'current month Cst_Key' =
			
			VAR SelectedMonth = SELECTEDVALUE(Silver_Membership_V1[Join Date Month])  -- 2
			VAR SelectedYear = 2025  -- fixed year as per your logic
			
			
			var result = CALCULATE(
			        DISTINCTCOUNT(Silver_Membership_V1[cst_cst_key]),
			        FILTER(
			            Silver_Membership_V1,
			            MONTH(Silver_Membership_V1[mbr_join_date]) = SelectedMonth &&
			            YEAR(Silver_Membership_V1[mbr_join_date]) = SelectedYear
			        )
			    )
			
			    RETURN result
		formatString: 0
