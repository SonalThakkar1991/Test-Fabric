	measure 'Total New Membership' = ```
			
			VAR SelectedMonth =
			    SELECTEDVALUE(Membership_dashboard_data[ReportMonth], MONTH(TODAY()))  -- Month number from slicer (e.g., 5 for May)
			VAR SelectedYear = SELECTEDVALUE(Membership_dashboard_data[ReportYear], YEAR(TODAY()))
			
			VAR StartDate =
			    DATE(SelectedYear, SelectedMonth, 7)
			
			VAR EndDate =
			    DATE(SelectedYear, SelectedMonth + 1, 6)
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('Membership_dashboard_data'[cst_cst_key]),
			        'Membership_dashboard_data'[mbr_join_date] >= StartDate &&
			        'Membership_dashboard_data'[mbr_join_date] <= EndDate,
			        'Membership_dashboard_data'[mbr_invoice_date] >= StartDate &&
			        'Membership_dashboard_data'[mbr_invoice_date] <= EndDate,
			        'Membership_dashboard_data'[cst_cst_member_flag] = 1,
			        ISBLANK('Membership_dashboard_data'[mbr_terminate_date]),
			        'Membership_dashboard_data'[mbr_expire_date] > DATE(SelectedYear, SelectedMonth, 31),
			        'Membership_dashboard_data'[inv_delete_flag] = 0,
			       'Membership_dashboard_data'[mxi_delete_flag] = 0,
			       ISBLANK(Membership_dashboard_data[ret_key]
			        
			    ))
			```
		formatString: 0
		lineageTag: c540ac9a-c9b5-49a9-ae72-ebbe96eed868

	measure 'Total Renew Membership' = ```
			
			VAR SelectedMonth =
			    SELECTEDVALUE(Membership_dashboard_data[ReportMonth], MONTH(TODAY()))  -- Month number from slicer (e.g., 5 for May)
			VAR SelectedYear = SELECTEDVALUE(Membership_dashboard_data[ReportYear], YEAR(TODAY())) -- e.g., 5 for May
			VAR InvoiceStartDate = DATE(SelectedYear, SelectedMonth, 7)
			VAR InvoiceEndDate = DATE(SelectedYear, SelectedMonth + 1, 6)
			VAR JoinCutoffDate = DATE(SelectedYear, SelectedMonth + 1, 1)   -- 6/1/2025 for May
			VAR ExpireCutoffDate = DATE(SelectedYear, SelectedMonth, 31)    -- 5/31/2025 for May
			VAR MXITermStartCutoff = DATE(SelectedYear, SelectedMonth + 1, 1)   -- 6/1/2025
			VAR MXIPreviousTermEndCutoff = DATE(SelectedYear, SelectedMonth, 31)  -- 5/31/2025
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('Membership_dashboard_data'[cst_cst_key]),
			        'Membership_dashboard_data'[mbr_join_date] < JoinCutoffDate,
			       'Membership_dashboard_data'[mbr_invoice_date] >= InvoiceStartDate,
			       'Membership_dashboard_data'[mbr_invoice_date] <= InvoiceEndDate,
			       'Membership_dashboard_data'[cst_cst_member_flag] = 1,
			        ISBLANK('Membership_dashboard_data'[mbr_terminate_date]),
			        'Membership_dashboard_data'[mbr_expire_date] > ExpireCutoffDate,
			      'Membership_dashboard_data'[mxi_term_start_date] >= MXITermStartCutoff,
			       'Membership_dashboard_data'[mxi_previous_term_end_date] >= MXIPreviousTermEndCutoff,
			      ISBLANK('Membership_dashboard_data'[ret_key])
			    )
			
			```
		formatString: 0
		lineageTag: eaf84974-8d76-42e8-afa6-3133e253f2ba

	measure 'Max Area Employee' =
