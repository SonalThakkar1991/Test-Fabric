	column 'Join Date Month' = FORMAT(Membership_dashboard_data[mbr_join_date],"MM")
		lineageTag: 6ff4cdef-dafd-475c-9e5c-93ffb901a60c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Join Date Year' = FORMAT(Membership_dashboard_data[mbr_join_date],"YYYY")
		lineageTag: 826a33fa-3de5-4038-98c9-574ce83e296a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column JoinMonthYear = FORMAT(Membership_dashboard_data[mbr_join_date], "MMM-YY")
		lineageTag: 973ae2b1-a4ef-4e2d-90f8-2983f9033f2b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Years Since Join' =
			
			YEAR(TODAY()) - YEAR(Membership_dashboard_data[mbr_join_date])
		formatString: 0
		lineageTag: 2f2fd3da-881d-41be-be70-5a0816713a9f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Year Distribution' =
			IF(Membership_dashboard_data[Years Since Join] >=1 && Membership_dashboard_data[Years Since Join] <=5, "1-5 Years",
			 IF(Membership_dashboard_data[Years Since Join] >=6 && Membership_dashboard_data[Years Since Join] <=10, "6-10 Years", "10+ Years"))
		lineageTag: 88c2d1ca-a374-40e3-aa7c-d32b913b7f5f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Year Experience' = Membership_dashboard_data[ind_years_experience_ccnursing_ext]
		lineageTag: 52bde3d6-3fd5-4928-8a78-7fdc99ff9577
		summarizeBy: none
		sortByColumn: SortOrder

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Age Criteria' =
			IF(Membership_dashboard_data[ind_age_cp] < 25 , "<25" ,
			    IF(Membership_dashboard_data[ind_age_cp] >=25 && Membership_dashboard_data[ind_age_cp] <=34 , "25-34",
			        IF(Membership_dashboard_data[ind_age_cp] >=35 && Membership_dashboard_data[ind_age_cp] <=44,"35-44",
			            IF(Membership_dashboard_data[ind_age_cp] >=45 && Membership_dashboard_data[ind_age_cp] <=54,"45-54",
			                IF(Membership_dashboard_data[ind_age_cp]>=55 && Membership_dashboard_data[ind_age_cp] <=64,"55-64",">64")))))
		lineageTag: 2e688e62-4c8f-4c2c-b244-1f95c067e608
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Age = Membership_dashboard_data[Age Criteria]
		lineageTag: 77a99f91-10dc-4d48-bbea-7e888f44fa1a
		summarizeBy: none
		sortByColumn: 'Age Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column ReportYear = INT(LEFT(FORMAT([ReportYearMonth], "000000"), 4))
		formatString: 0
		lineageTag: 63b72419-6d7b-4b55-8796-60a195bf9f13
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ReportMonth = ```
			INT(RIGHT(FORMAT([ReportYearMonth], "000000"), 2))
			
			```
		formatString: 0
		lineageTag: 527b09b7-242b-4294-8cdc-229ee6bfcef7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Year-Month =
			
			var x = CONCATENATE(Membership_dashboard_data[ReportYear],"-")
			VAR y = CONCATENATE(x, FORMAT(Membership_dashboard_data[ReportMonth], "00"))
			return y
		lineageTag: c3a836a2-d63c-4315-a7e6-74d60dd459fb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column SortOrder =
			
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext]  = "LESS2", 1,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "2-3", 2,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "4-5", 3,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "6-10", 4,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "11-15", 5,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "16-20", 6,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext]  = "21-25", 7,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "26-30", 8,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "31-35", 9,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext] = "36-40", 10,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext]  = "41PLUS", 11,
			IF(Membership_dashboard_data[ind_years_experience_ccnursing_ext]  = "DECLINE", 12,
			99))))))))
			))))
		formatString: 0
		lineageTag: f0c168fe-903f-4e15-87f4-10ba958263e8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Age Sort' = ```
			
			SWITCH(
			    TRUE(),
			    Membership_dashboard_data[Age Criteria] = "<25", 1,
			     Membership_dashboard_data[Age Criteria] = "25-34", 2,
			     Membership_dashboard_data[Age Criteria] = "35-44", 3,
			    Membership_dashboard_data[Age Criteria] = "45-54", 4,
			     Membership_dashboard_data[Age Criteria] = "55-64", 5,
			     Membership_dashboard_data[Age Criteria] = ">64", 6,
			    99  -- Default fallback
			)
			
			```
		formatString: 0
		lineageTag: acad7b9d-be45-41aa-b0f0-ccf5dc3d42c6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

