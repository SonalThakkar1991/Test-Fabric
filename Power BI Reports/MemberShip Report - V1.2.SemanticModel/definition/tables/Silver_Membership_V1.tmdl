	partition Silver_Membership_V1 = m
		mode: import
		source =
				let
				    Source = Sql.Database("27je7sxkqxjefn5tgdxsmzwhvm-klq2mx4rz2fuppjgtqdyjb7ccm.datawarehouse.fabric.microsoft.com", "Dev_Silver_Lakehouse", [Query="select DISTINCT #(lf)id.cst_cst_key,#(lf)id.cst_cst_recno,#(lf)id.cst_cst_id,#(lf)id.ind_int_code,#(lf)id.ind_prf_code,#(lf)id.ind_sfx_code,#(lf)id.ind_first_name,#(lf)id.ind_last_name,#(lf)id.cst_cst_member_flag,#(lf)id.ind_designation,#(lf)FLOOR(DATEDIFF(day, id.ind_dob, GETDATE()) / 365.25) AS ind_age_cp,#(lf)id.ind_dob,#(lf)id.ind_gender,#(lf)id.ind_ethnicity,#(lf)cie.ind_highest_nursing_degree_ext,#(lf)cie. ind_qtly_nurse_segment_ext,#(lf)cie.ind_primary_position_ext,#(lf)cie.ind_area_employed_ext,#(lf)cie.ind_years_experience_ccnursing_ext,#(lf)cie.ind_primary_clinical_specialty_ext,#(lf)cie.ind_nurse_segment_ext,#(lf)ca.adr_city,#(lf)ca.adr_state,#(lf)ca.adr_country,#(lf)id.cst_cst_eml_address_dn,#(lf)p.prd_name as membership_type,#(lf)m.mbr_join_date,#(lf)m.mbr_rejoin_date,#(lf)m.mbr_add_date,#(lf)m.mbr_expire_date,#(lf)m.mbr_terminate_date,#(lf)m.mbr_invoice_date,#(lf)inv.inv_delete_flag,#(lf)mx.mxi_delete_flag,#(lf)min(mx.mxi_term_start_date) as mxi_term_start_date,#(lf)max(mx.mxi_term_end_date) as mxi_term_end_date,#(lf)min(mx.mxi_previous_term_start_date) as mxi_previous_term_start_date,#(lf)max(mx.mxi_previous_term_end_date) as mxi_previous_term_end_date,#(lf)ar.ret_key,#(lf)FLOOR(DATEDIFF(DAY, m.mbr_join_date, m.mbr_expire_date)/365.25) AS total_years_of_membership#(lf)From MDM.Netforum_Membership m #(lf)left join MDM.Netforum_Individual id#(lf)on m.mbr_cst_key = id.cst_cst_key#(lf)left join Netforum.co_individual_ext cie#(lf)on id.cst_cst_key = cie.ind_cst_key_ext #(lf)left join Netforum.co_address ca#(lf)on id.cst_cst_key=ca.adr_cst_key_owner#(lf)left join [Netforum].[ac_invoice] inv#(lf)on id.cst_cst_key=inv.inv_cst_key#(lf)LEFT JOIN [Netforum].[oe_package] op #(lf)ON m.mbr_pak_prd_key = op.pak_prd_key#(lf)LEFT JOIN [MDM].[Netforum_Product] p #(lf)ON op.pak_prd_key = p.prd_key#(lf)left join Netforum.ac_return ar#(lf)on id.cst_cst_key = ar.ret_cst_key#(lf)left join [Netforum].[mb_membership_x_ac_invoice] mx#(lf)on m.mbr_key = mx.mxi_mbr_key#(lf)--1496378#(lf)#(lf)--where id.cst_cst_key = 'f7050369-451e-4436-a1fe-e5dea18059a9'#(lf)#(lf)group by #(lf)id.cst_cst_key,#(lf)id.cst_cst_recno,#(lf)id.cst_cst_id,#(lf)id.ind_int_code,#(lf)id.ind_prf_code,#(lf)id.ind_sfx_code,#(lf)id.ind_first_name,#(lf)id.ind_last_name,#(lf)id.cst_cst_member_flag,#(lf)ind_age_cp,#(lf)id.ind_dob,#(lf)id.ind_gender,#(lf)id.ind_ethnicity,#(lf)id.ind_designation,#(lf)cie.ind_highest_nursing_degree_ext,#(lf)cie. ind_qtly_nurse_segment_ext,#(lf)cie.ind_primary_position_ext,#(lf)cie.ind_area_employed_ext,#(lf)cie.ind_years_experience_ccnursing_ext,#(lf)cie.ind_primary_clinical_specialty_ext,#(lf)cie.ind_nurse_segment_ext,#(lf)ca.adr_city,#(lf)ca.adr_state,#(lf)ca.adr_country,#(lf)id.cst_cst_eml_address_dn,#(lf)p.prd_name,#(lf)m.mbr_join_date,#(lf)m.mbr_add_date,#(lf)m.mbr_rejoin_date,#(lf)m.mbr_expire_date,#(lf)mx.mxi_delete_flag,#(lf)m.mbr_terminate_date,#(lf)m.mbr_invoice_date,#(lf)inv.inv_delete_flag,#(lf)ar.ret_key"])
				in
				    Source

