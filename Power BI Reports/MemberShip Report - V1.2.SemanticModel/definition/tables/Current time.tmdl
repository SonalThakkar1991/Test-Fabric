	partition 'Current time' = m
		mode: import
		source =
				let
				    // Get the current local date and time
				    CurrentLocalDateTime = DateTime.LocalNow(),
				
				    // Convert to UTC
				    CurrentUTCDateTime = DateTimeZone.SwitchZone(DateTimeZone.From(CurrentLocalDateTime), 0),
				    #"Converted to Table" = #table(1, {{CurrentUTCDateTime}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Converted to Table",{{"Column1", type datetime}})
				in
				    #"Changed Type"

