	measure 'Latest Count' = ```
			
			VAR LatestDate =
			    CALCULATE (
			        MAX ( 'Passed Tables List'[LoadDate_PST] ),
			        ALLEXCEPT ( 'Passed Tables List', 'Passed Tables List'[Table_Name] )
			    )
			RETURN
			    CALCULATE (
			        MAX ( 'Passed Tables List'[Count] ),
			        'Passed Tables List'[LoadDate_PST] = LatestDate
			    )
			
			```
		formatString: 0
		lineageTag: 5d21a530-e74a-449d-9c14-07f374b04a41

	measure 'Total Latest Count' = ```
			
			SUMX (
			    SUMMARIZE (
			        'Passed Tables List',
			        'Passed Tables List'[Table_Name],
			        "LatestDate", CALCULATE ( MAX ( 'Passed Tables List'[LoadDate_PST] ) )
			    ),
			    VAR TableName = [Table_Name]
			    VAR LatestDate =
			        CALCULATE (
			            MAX ( 'Passed Tables List'[LoadDate_PST] ),
			            'Passed Tables List'[Table_Name] = TableName
			        )
			    RETURN
			        CALCULATE (
			            MAX ( 'Passed Tables List'[Count] ),
			            'Passed Tables List'[Table_Name] = TableName,
			            'Passed Tables List'[LoadDate_PST] = LatestDate
			        )
			)
			
			```
		formatString: 0
		lineageTag: 8f808cfc-a9c6-49ba-a0b8-e31c87cde266

