	measure SourceSystemFilter = ```
			
			VAR SelectedCount =
			    CALCULATE(
			        DISTINCTCOUNT('Source System'[Source System]),
			        ALLSELECTED('Source System')
			    )
			VAR SelectedValue =
			    SELECTEDVALUE('Source System'[Source System])
			RETURN
			    IF(
			        ISBLANK(SelectedValue) || SelectedCount = 2,
			        TRUE(),  -- Treat as ALL (both selected or nothing selected)
			        MAX('Source System'[Source System]) = SelectedValue
			    )
			
			
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1e168612-3937-4ddb-83fd-79d31ddacf29

	measure Measure_Filtered = ```
			
			CALCULATE(
			    [SourceSystemFilter],
			    FILTER(
			        ALL('Source System'),
			        VAR SelectedCount =
			            CALCULATE(
			                DISTINCTCOUNT('Source System'[Source System]),
			                ALLSELECTED('Source System')
			            )
			        VAR SelectedValue =
			            SELECTEDVALUE('Source System'[Source System])
			        RETURN
			            ISBLANK(SelectedValue) ||
			            SelectedCount = 2 ||
			            'Source System'[Source System] = SelectedValue
			    )
			)
			
			```
		formatString: 0
		lineageTag: 75d7919c-017e-454e-ae84-b9755379d6c7

